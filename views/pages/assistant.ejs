<% layout('/layouts/boilerplate') -%>
<section class="page-hero compact"><span class="eyebrow">✦ Clinical reasoning workspace</span><h1>A quieter way to think through the chart.</h1><p>Ask grounded questions against the patient record, then turn the answer into a structured consultation note.</p><label class="inline-picker"><span>Context patient</span><select data-assistant-patient><% patients.forEach((patient) => { %><option value="<%= patient._id %>" <%= String(patient._id) === String(selectedPatientId) ? 'selected' : '' %>><%= patient.fullName %> · <%= patient.mrn %></option><% }) %></select></label></section>
<div class="assistant-layout" data-assistant>
  <section class="surface chat-panel"><div class="assistant-head"><div><span class="assistant-icon">✦</span><span><strong>Clinical copilot</strong><small>Grounded in the patient record</small></span></div><b><i></i> Ready</b></div><div class="message-list" data-message-list><div class="message assistant"><p>Hello, Doctor. I have indexed this patient's verified records. What would you like to understand today?</p></div></div><div class="suggestion-row"><button type="button" data-prompt="Summarize glycemic status and HbA1c history">Glycemic status</button><button type="button" data-prompt="Screen active medications for interactions">Medication interactions</button><button type="button" data-prompt="Review allergy risks">Allergy risks</button></div><form class="chat-composer" data-chat-form><input name="message" placeholder="Ask a question about this patient…" autocomplete="off" required><button type="submit">→</button></form></section>
  <section class="surface soap-panel"><div class="assistant-head"><div><span class="assistant-icon soap">▤</span><span><strong>Consultation note</strong><small>Draft a structured SOAP note</small></span></div><button class="mini-button" type="button" data-copy-soap hidden>Copy</button></div><p class="panel-description">Use the verified record as your starting point. The draft remains editable and requires physician sign-off.</p><textarea class="soap-prompt" data-soap-prompt placeholder="Add a consultation focus or physician context…"></textarea><button class="button gradient full" type="button" data-generate-soap>✦ Generate structured note</button><div class="soap-sections" data-soap-output><div class="soap-empty">Your generated note will appear here.</div></div></section>
</div>
