<!-- Interactive Tab Switcher Script -->
<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    const heroVideo = document.querySelector('.nabla-hero-video');
    const heroVideoSource = heroVideo?.querySelector('source[data-src]');
    const heroMediaToggle = document.getElementById('heroMediaToggle');
    const heroMediaIcon = heroMediaToggle?.querySelector('.deus-hero-media-icon');
    const heroMediaLabel = heroMediaToggle?.querySelector('.deus-hero-media-label');
    const mobileNavToggle = document.getElementById('deusMobileNavToggle');
    const mobileNavPanel = document.getElementById('deusMobileNavPanel');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let heroVideoLoaded = false;

    const closeMobileNav = () => {
      if (!mobileNavToggle || !mobileNavPanel) return;
      mobileNavToggle.setAttribute('aria-expanded', 'false');
      mobileNavPanel.hidden = true;
    };

    mobileNavToggle?.addEventListener('click', () => {
      if (!mobileNavPanel) return;
      const isOpen = mobileNavToggle.getAttribute('aria-expanded') === 'true';
      mobileNavToggle.setAttribute('aria-expanded', String(!isOpen));
      mobileNavPanel.hidden = isOpen;
    });

    mobileNavPanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileNav));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMobileNav();
    });

    const loadHeroVideo = () => {
      if (!heroVideo || !heroVideoSource || heroVideoLoaded) return;
      heroVideoSource.src = heroVideoSource.dataset.src;
      heroVideoLoaded = true;
      heroVideo.load();
    };

    const scheduleHeroVideo = () => {
      if (!heroVideo || prefersReducedMotion.matches) return;
      const connection = navigator.connection;
      if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType || '')) return;
      const start = () => {
        loadHeroVideo();
        heroVideo.play().catch(() => {});
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(start, { timeout: 2200 });
      } else {
        window.setTimeout(start, 1200);
      }
    };

    const syncHeroMediaControl = () => {
      if (!heroVideo || !heroMediaToggle) return;
      const isPaused = heroVideo.paused;
      heroMediaToggle.setAttribute('aria-pressed', String(isPaused));
      heroMediaToggle.setAttribute('aria-label', isPaused ? 'Play background video' : 'Pause background video');
      if (heroMediaIcon) heroMediaIcon.textContent = isPaused ? '▶' : 'Ⅱ';
      if (heroMediaLabel) heroMediaLabel.textContent = isPaused ? 'Play motion' : 'Pause motion';
    };

    if (heroVideo && prefersReducedMotion.matches) heroVideo.pause();
    syncHeroMediaControl();

    heroMediaToggle?.addEventListener('click', () => {
      if (!heroVideo) return;
      loadHeroVideo();
      if (heroVideo.paused) {
        heroVideo.play().catch(() => {});
      } else {
        heroVideo.pause();
      }
      syncHeroMediaControl();
    });

    heroVideo?.addEventListener('play', syncHeroMediaControl);
    heroVideo?.addEventListener('pause', syncHeroMediaControl);
    prefersReducedMotion.addEventListener?.('change', (event) => {
      if (!heroVideo) return;
      if (event.matches) heroVideo.pause();
      syncHeroMediaControl();
    });

    if (document.readyState === 'complete') {
      scheduleHeroVideo();
    } else {
      window.addEventListener('load', scheduleHeroVideo, { once: true });
    }

    const tabs = document.querySelectorAll('[data-nabla-tab]');
    const panes = document.querySelectorAll('.nabla-tab-pane');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-nabla-tab');
        tabs.forEach((t) => t.classList.remove('is-active'));
        panes.forEach((p) => p.classList.remove('is-active'));

        tab.classList.add('is-active');
        const targetPane = document.getElementById('pane-' + target);
        if (targetPane) {
          targetPane.classList.add('is-active');
        }
      });
    });
  });
</script>
