        </div>
        <div class="nabla-demo-header-right">
          <span class="nabla-mode-badge">Human-in-the-loop Active</span>
        </div>
      </div>

      <!-- Demo Tabs -->
      <div class="nabla-tabs-bar" role="tablist">
        <button class="nabla-tab is-active" type="button" data-nabla-tab="soap">
          <span class="nabla-tab-icon">📋</span>
          <span>Ambient SOAP Note</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="prescription">
