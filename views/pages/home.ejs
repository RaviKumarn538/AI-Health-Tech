          <span>Prescription OCR</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="labs">
          <span class="nabla-tab-icon">🧪</span>
          <span>Critical Lab Shield</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="interactions">
