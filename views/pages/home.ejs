<% layout("layouts/boilerplate") %>

<% const dashboardSignInUrl = (typeof googleAuthUrl !== 'undefined' && googleAuthUrl) || '/auth/google?next=%2Fdashboard'; %>

<div class="nabla-home-container">
  <header class="nabla-public-nav" aria-label="Public navigation">
    <a class="nabla-public-brand deus-public-brand" href="/" aria-label="DEUS AI-powered Clinical Intelligence home">
      <span class="nabla-public-brand-mark">D</span>
      <span class="deus-brand-copy"><strong>DEUS</strong><small>AI-powered Clinical Intelligence</small></span>
    </a>
    <nav class="nabla-public-links" aria-label="Homepage links">
      <a href="#interactiveDemo">Platform</a>
      <a href="#capabilities">Clinical Intelligence</a>
      <a href="#workflow">How it works</a>
      <a href="#security">Security</a>
      <a href="#team">Team</a>
      <a href="/patient/login">Patient portal</a>
      <a href="<%= dashboardSignInUrl %>">Sign in</a>
      <a class="nabla-public-cta" href="<%= dashboardSignInUrl %>">Open Workspace <span aria-hidden="true">→</span></a>
    </nav>
    <button class="deus-mobile-nav-toggle" id="deusMobileNavToggle" type="button" aria-expanded="false" aria-controls="deusMobileNavPanel">
      <span class="deus-mobile-nav-label">Menu</span>
      <span class="deus-mobile-nav-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
    <div class="deus-mobile-nav-panel" id="deusMobileNavPanel" hidden>
      <a href="#interactiveDemo">Platform</a>
      <a href="#capabilities">Clinical Intelligence</a>
      <a href="#workflow">How it works</a>
      <a href="#security">Security</a>
      <a href="#team">Team</a>
      <a href="/patient/login">Patient portal</a>
      <a href="<%= dashboardSignInUrl %>">Sign in</a>
      <a class="deus-mobile-nav-cta" href="<%= dashboardSignInUrl %>">Open Workspace <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <!-- Background Glow & Mesh -->
  <div class="nabla-ambient-glow nabla-glow-top" aria-hidden="true"></div>
  <div class="nabla-ambient-glow nabla-glow-right" aria-hidden="true"></div>

  <!-- HERO SECTION -->
  <section class="nabla-hero-section" id="heroSection" aria-labelledby="heroTitle">
    <div class="nabla-hero-stage">
      <video class="nabla-hero-video" autoplay muted loop playsinline preload="none" poster="/images/clinical-hero.svg" aria-label="Clinical AI documentation workflow preview">
        <!-- Load the remote motion only after the first page render; the local poster is immediate. -->
        <source data-src="https://media.gettyimages.com/id/2099365133/video/young-female-doctor-using-a-headset-at-work.mp4?s=mp4-640x640-gi&k=20&c=1KxhQ2E5HfGVKu3OoUp2KxJ3MJK_Z0VPcGSzjoc_GgU=" type="video/mp4">
      </video>
      <div class="nabla-hero-video-fallback" aria-hidden="true"></div>
      <div class="nabla-hero-scrim" aria-hidden="true"></div>

      <div class="nabla-hero-content">
        <div class="nabla-badge-wrapper">
          <div class="nabla-badge">
            <span class="nabla-badge-dot"></span>
            <span class="nabla-badge-text">DEUS · AI-powered Clinical Intelligence</span>
            <span class="nabla-badge-tag">Human-centered</span>
          </div>
        </div>

        <h1 class="nabla-hero-title" id="heroTitle">
          Clinical intelligence for the<br>
          <span class="nabla-gradient-text">human side of care.</span>
        </h1>

        <p class="nabla-hero-subtitle">
          DEUS turns documents, conversations, and patient context into review-ready clinical intelligence—keeping clinicians in control.
        </p>

        <div class="nabla-hero-actions">
          <a class="nabla-btn-primary" href="<%= dashboardSignInUrl %>" id="heroSignInBtn">
            <span>Sign in to DEUS Workspace</span>
            <svg class="nabla-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a class="nabla-btn-secondary" href="#interactiveDemo" id="heroTryAssistantBtn">
            <span class="nabla-btn-sparkle">✦</span>
            <span>See how it works</span>
          </a>
          <a class="nabla-btn-ghost" href="#workflow" id="heroUploadRecordBtn">
            <span>View clinical workflow</span>
            <span class="nabla-arrow">↗</span>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="nabla-trust-strip">
          <div class="nabla-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A7F3D0" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Privacy-first document handling</span>
          </div>
          <span class="nabla-trust-sep">·</span>
          <div class="nabla-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A7F3D0" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>FHIR R4 Sandbox</span>
          </div>
          <span class="nabla-trust-sep">·</span>
          <div class="nabla-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A7F3D0" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            <span>Clinician-reviewed workflows</span>
          </div>
        </div>

      </div>

      <div class="deus-hero-controls" aria-label="Hero media controls">
        <button class="deus-hero-media-toggle" id="heroMediaToggle" type="button" aria-pressed="false" aria-label="Pause background video">
          <span class="deus-hero-media-icon" aria-hidden="true">Ⅱ</span>
          <span class="deus-hero-media-label">Pause motion</span>
        </button>
        <a class="deus-hero-explore-link" href="#medicalShowcaseTitle">
          <span>Explore platform</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- MEDICAL FIELD IMAGE STORY -->
  <section class="nabla-medical-showcase" aria-labelledby="medicalShowcaseTitle">
    <div class="nabla-medical-showcase-copy">
      <span class="nabla-section-tag">CARE, CONNECTED</span>
      <h2 id="medicalShowcaseTitle">Keep the human moment at the center.</h2>
      <p>Turn conversation, chart, and next action into one calm clinical workflow.</p>
      <div class="nabla-showcase-proof">
        <span class="nabla-showcase-proof-icon">✦</span>
        <span><strong>Designed for real care</strong><br>Clinician review stays at the center.</span>
      </div>
    </div>

    <div class="nabla-medical-image-grid">
      <figure class="nabla-medical-image-card nabla-medical-image-large">
        <img src="https://images.unsplash.com/photo-1758691463000-08b98131daf3?auto=format&amp;fit=crop&amp;w=1600&amp;q=82" width="1600" height="1067" alt="Doctor showing a patient medical scan on a tablet" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>
          <span>01</span>
          <strong>More presence. Less paperwork.</strong>
          <small>Ambient conversation capture</small>
        </figcaption>
      </figure>
      <figure class="nabla-medical-image-card nabla-medical-image-top">
        <img src="https://images.unsplash.com/photo-1758691463569-66de91d76452?auto=format&amp;fit=crop&amp;w=1200&amp;q=82" width="1200" height="800" alt="Two clinicians reviewing a medical scan on a tablet" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>
          <span>02</span>
          <strong>One clear clinical story.</strong>
          <small>Structured evidence and review</small>
        </figcaption>
      </figure>
      <figure class="nabla-medical-image-card nabla-medical-image-bottom">
        <img src="https://images.unsplash.com/photo-1758691462667-f2fb90a067ff?auto=format&amp;fit=crop&amp;w=1200&amp;q=82" width="1200" height="800" alt="Doctor reviewing MRI images on a clinical tablet" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>
          <span>03</span>
          <strong>Confidence at sign-off.</strong>
          <small>Human-in-the-loop safety checks</small>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- PRODUCT INTELLIGENCE WORKSTATION -->
  <section class="nabla-demo-section deus-product-intelligence-section" id="interactiveDemo" aria-labelledby="productIntelligenceTitle">
    <div class="deus-section-heading deus-section-heading-left">
      <div class="deus-heading-lockup">
        <div class="deus-heading-copy">
          <span class="deus-section-eyebrow">PRODUCT INTELLIGENCE</span>
          <h2 id="productIntelligenceTitle">A clinical workstation built for review.</h2>
          <p>Documents, conversations, and labs—structured for clinician review.</p>
        </div>
        <img class="deus-heading-visual" src="https://images.unsplash.com/photo-1758691462667-f2fb90a067ff?auto=format&amp;fit=crop&amp;w=640&amp;q=84" width="320" height="220" alt="Clinician reviewing medical information on a tablet" loading="lazy" decoding="async" referrerpolicy="no-referrer">
      </div>
    </div>
    <div class="nabla-demo-card">
      <div class="nabla-demo-header">
        <div class="nabla-demo-header-left">
          <div class="nabla-live-dot"></div>
          <span class="nabla-demo-title">DEUS Clinical Intelligence Engine</span>
          <span class="nabla-demo-version">Reviewable workflow preview</span>
        </div>
        <div class="nabla-demo-header-right">
          <span class="nabla-mode-badge">Human-in-the-loop Active</span>
        </div>
      </div>

      <!-- Demo Tabs -->
      <div class="nabla-tabs-bar" role="tablist">
        <button class="nabla-tab is-active" type="button" data-nabla-tab="soap">
          <span class="nabla-tab-icon">📋</span>
          <span>Ambient SOAP Note</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="prescription">
          <span class="nabla-tab-icon">💊</span>
          <span>Prescription OCR</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="labs">
          <span class="nabla-tab-icon">🧪</span>
          <span>Critical Lab Shield</span>
        </button>
        <button class="nabla-tab" type="button" data-nabla-tab="interactions">
          <span class="nabla-tab-icon">🛡</span>
          <span>Drug Interaction Check</span>
        </button>
      </div>

      <!-- Demo Content Views -->
      <div class="nabla-demo-content">
        <!-- TAB 1: SOAP NOTE -->
        <div class="nabla-tab-pane is-active" id="pane-soap">
          <div class="nabla-split-grid">
            <div class="nabla-input-col">
              <div class="nabla-col-label">
                <span class="nabla-pulse-ring"></span>
                <span>Doctor-Patient Encounter Audio &amp; Transcript</span>
              </div>
              <div class="nabla-audio-visualizer">
                <span class="nabla-bar"></span><span class="nabla-bar"></span><span class="nabla-bar"></span>
                <span class="nabla-bar"></span><span class="nabla-bar"></span><span class="nabla-bar"></span>
                <span class="nabla-bar"></span><span class="nabla-bar"></span><span class="nabla-bar"></span>
                <span class="nabla-bar"></span><span class="nabla-bar"></span><span class="nabla-bar"></span>
                <span class="nabla-audio-time">04:18 / 06:30 · Active Consultation</span>
              </div>
              <blockquote class="nabla-transcript-quote">
                "Patient Rajesh Sharma presenting for regular diabetic follow-up. Blood pressure today is 138/88. He reports mild morning dizziness but no chest pain. Fasting blood sugar measured 154 mg/dL and HbA1c is 7.8%. Serum creatinine is slightly up at 1.35. Continuing Telmisartan 40mg daily and Metformin 500mg twice daily with meals. Penicillin allergy confirmed."
              </blockquote>
              <div class="nabla-input-footer">
                <span class="nabla-badge-subtle">Patient: Rajesh Sharma (CC-1001)</span>
                <span class="nabla-badge-subtle">Audio Clarity: 98.6%</span>
              </div>
            </div>

            <div class="nabla-output-col">
              <div class="nabla-col-label">
                <span class="nabla-check-icon">✓</span>
                <span>Auto-Generated Clinical SOAP Note (Ready for Sign-Off)</span>
              </div>
              <div class="nabla-soap-box">
                <div class="nabla-soap-row">
                  <span class="nabla-soap-tag tag-s">S</span>
                  <div class="nabla-soap-text">
                    <strong>Subjective:</strong> 52-year-old male with known Type 2 DM and HTN presents for follow-up. Reports mild morning dizziness; denies syncope, chest pain, or shortness of breath. Known Penicillin anaphylaxis.
                  </div>
                </div>
                <div class="nabla-soap-row">
                  <span class="nabla-soap-tag tag-o">O</span>
                  <div class="nabla-soap-text">
                    <strong>Objective:</strong> BP: 138/88 mmHg. Fasting Blood Glucose: <mark class="nabla-mark-high">154 mg/dL (HIGH)</mark>. HbA1c: <mark class="nabla-mark-high">7.8% (HIGH)</mark>. Serum Creatinine: <mark class="nabla-mark-alert">1.35 mg/dL (ELEVATED)</mark>.
                  </div>
                </div>
                <div class="nabla-soap-row">
                  <span class="nabla-soap-tag tag-a">A</span>
                  <div class="nabla-soap-text">
                    <strong>Assessment:</strong> 1. Type 2 Diabetes Mellitus with suboptimal glycemic control. 2. Essential Hypertension, moderately controlled. 3. Mild renal parameter elevation.
                  </div>
                </div>
                <div class="nabla-soap-row">
                  <span class="nabla-soap-tag tag-p">P</span>
                  <div class="nabla-soap-text">
                    <strong>Plan:</strong> 1. Continue Metformin 500 mg PO BD with meals. 2. Continue Telmisartan 40 mg PO OD morning. 3. Repeat renal function &amp; glycemic profile in 6 weeks.
                  </div>
                </div>
              </div>
              <div class="nabla-output-footer">
                <span class="nabla-verified-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  Signed by <%= clinicianName %>
                </span>
          <a class="nabla-inline-link" href="#workflow">See the workflow →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 2: PRESCRIPTION OCR -->
        <div class="nabla-tab-pane" id="pane-prescription">
          <div class="nabla-split-grid">
            <div class="nabla-input-col">
              <div class="nabla-col-label">
                <span>Clinical Source Document (Prescription Slip)</span>
              </div>
              <div class="nabla-doc-preview">
                <div class="nabla-doc-header">
                  <strong>Rx Cardiology OPD · Dr. Rao</strong>
                  <span class="nabla-badge-subtle">sample_prescription_cardiology.png</span>
                </div>
                <div class="nabla-rx-raw-content">
                  <p>1. Tab. Telmisartan 40 mg - 1 Tab OD (Morning) x 30 days</p>
                  <p>2. Tab. Metformin 500 mg - 1 Tab BD (After food) x 30 days</p>
                  <p>3. Tab. Atorvastatin 20 mg - 1 Tab HS (Night) x 30 days</p>
                </div>
              </div>
            </div>
            <div class="nabla-output-col">
              <div class="nabla-col-label">
                <span>Structured clinical extraction</span>
              </div>
              <div class="nabla-meds-list">
                <div class="nabla-med-item">
                  <div class="nabla-med-main">
                    <strong>Telmisartan</strong>
                    <span class="nabla-med-dose">40 mg</span>
                  </div>
                  <div class="nabla-med-meta">
                    <span>Route: Oral</span> · <span>Frequency: Once daily (OD)</span> · <span>Take in morning</span>
                  </div>
                  <span class="nabla-badge-verified">Ready for review</span>
                </div>
                <div class="nabla-med-item">
                  <div class="nabla-med-main">
                    <strong>Metformin</strong>
                    <span class="nabla-med-dose">500 mg</span>
                  </div>
                  <div class="nabla-med-meta">
                    <span>Route: Oral</span> · <span>Frequency: Twice daily (BD)</span> · <span>Take with meals</span>
                  </div>
                  <span class="nabla-badge-verified">Ready for review</span>
                </div>
                <div class="nabla-med-item">
                  <div class="nabla-med-main">
                    <strong>Atorvastatin</strong>
                    <span class="nabla-med-dose">20 mg</span>
                  </div>
                  <div class="nabla-med-meta">
                    <span>Route: Oral</span> · <span>Frequency: At bedtime (HS)</span> · <span>Lipid management</span>
                  </div>
                  <span class="nabla-badge-verified">Ready for review</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: CRITICAL LAB SHIELD -->
        <div class="nabla-tab-pane" id="pane-labs">
          <div class="nabla-split-grid">
            <div class="nabla-input-col">
              <div class="nabla-col-label">
                <span>Metabolic Laboratory Panel (Automated Parsing)</span>
              </div>
              <div class="nabla-doc-preview">
                <div class="nabla-doc-header">
                  <strong>Comprehensive Metabolic Panel</strong>
                  <span class="nabla-badge-subtle">sample_lab_report_metabolic.png</span>
                </div>
                <div class="nabla-rx-raw-content">
                  <p>Fasting Blood Sugar: 154 mg/dL [Ref 70 - 99 mg/dL]</p>
                  <p>Glycated Hemoglobin (HbA1c): 7.8% [Ref 4.0 - 5.6%]</p>
                  <p>Serum Creatinine: 1.35 mg/dL [Ref 0.6 - 1.2 mg/dL]</p>
                </div>
              </div>
            </div>
            <div class="nabla-output-col">
              <div class="nabla-col-label">
                <span>Clinical Guardrail Alert System (3 Anomalies Flagged)</span>
              </div>
              <div class="nabla-alerts-list">
                <div class="nabla-alert-item alert-high">
                  <div class="nabla-alert-header">
                    <span class="nabla-alert-badge">HIGH</span>
                    <strong>Fasting Blood Sugar: 154 mg/dL</strong>
                  </div>
                  <p>Elevated above reference range (70 - 99 mg/dL). Action: Glycemic control titration indicated.</p>
                </div>
                <div class="nabla-alert-item alert-high">
                  <div class="nabla-alert-header">
                    <span class="nabla-alert-badge">HIGH</span>
                    <strong>HbA1c: 7.8%</strong>
                  </div>
                  <p>Diagnostic of suboptimal diabetes management. Target &lt; 7.0% recommended.</p>
                </div>
                <div class="nabla-alert-item alert-warn">
                  <div class="nabla-alert-header">
                    <span class="nabla-alert-badge">ELEVATED</span>
                    <strong>Serum Creatinine: 1.35 mg/dL</strong>
                  </div>
                  <p>Slightly elevated above normal baseline. Action: Monitor eGFR and renal parameters.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 4: DRUG INTERACTIONS -->
        <div class="nabla-tab-pane" id="pane-interactions">
          <div class="nabla-split-grid">
            <div class="nabla-input-col">
              <div class="nabla-col-label">
                <span>Patient Allergy Profile &amp; Prescription Candidate</span>
              </div>
              <div class="nabla-doc-preview">
                <div class="nabla-doc-header">
                  <strong>Safety Screen Engine</strong>
                  <span class="nabla-badge-subtle">Real-time Check</span>
                </div>
                <div class="nabla-rx-raw-content">
                  <p><strong>Known Allergies:</strong> Penicillin, Amoxicillin (Severe anaphylaxis)</p>
                  <p><strong>Candidate Medications:</strong> Telmisartan, Metformin, Amoxicillin-Clavulanate</p>
                </div>
              </div>
            </div>
            <div class="nabla-output-col">
              <div class="nabla-col-label">
                <span>Interaction &amp; Allergy Conflict Shield</span>
              </div>
              <div class="nabla-safety-card">
                <div class="nabla-conflict-banner">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                  <div>
                    <strong>CRITICAL ALLERGY CONFLICT DETECTED</strong>
                    <p>Patient is allergic to Penicillin. Prescribed Amoxicillin contains cross-reactive beta-lactam ring.</p>
                  </div>
                </div>
                <div class="nabla-conflict-recommendation">
                  <strong>AI Safety Recommendation:</strong> Do not dispense Amoxicillin. Consider Azithromycin or Clarithromycin as non-beta-lactam alternative under clinician review.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLINICAL DOCUMENT INTELLIGENCE -->
  <section class="deus-transformation-section deus-premium-section" aria-labelledby="transformationTitle">
    <div class="deus-section-heading">
      <div class="deus-heading-lockup">
        <div class="deus-heading-copy">
          <span class="deus-section-eyebrow">CLINICAL DOCUMENT INTELLIGENCE</span>
          <h2 id="transformationTitle">From source to signed-off record.</h2>
          <p>Every field keeps its source, confidence, and reviewer.</p>
        </div>
        <img class="deus-heading-visual" src="https://images.unsplash.com/photo-1758691463569-66de91d76452?auto=format&amp;fit=crop&amp;w=640&amp;q=84" width="320" height="220" alt="Two clinicians reviewing a medical record together" loading="lazy" decoding="async" referrerpolicy="no-referrer">
      </div>
    </div>
    <div class="deus-transformation-flow" role="list" aria-label="Clinical document transformation workflow">
      <article class="deus-transformation-step" role="listitem">
        <div class="deus-transformation-step-head"><span>01</span><small>SOURCE DOCUMENT</small></div>
        <div class="deus-document-sheet" aria-label="Sample prescription source document">
          <div class="deus-document-topline"><span>RX / CARDIOLOGY OPD</span><span>CC-1001</span></div>
          <strong>Clinical prescription</strong>
          <div class="deus-document-line wide"></div>
          <div class="deus-document-line"></div>
          <div class="deus-document-line short"></div>
          <div class="deus-document-handwriting">Telmisartan 40 mg<br>Metformin 500 mg</div>
        </div>
        <p>Prescription, lab report, or conversation.</p>
      </article>
      <span class="deus-transformation-arrow" aria-hidden="true">→</span>
      <article class="deus-transformation-step" role="listitem">
        <div class="deus-transformation-step-head"><span>02</span><small>AI EXTRACTION</small></div>
        <div class="deus-extraction-sheet">
          <div class="deus-extraction-row"><span>Medication</span><strong>Telmisartan 40 mg</strong><em>98.6%</em></div>
          <div class="deus-extraction-row"><span>Frequency</span><strong>Once daily · Oral</strong><em>97.9%</em></div>
          <div class="deus-extraction-row is-review"><span>Allergy signal</span><strong>Penicillin · Review</strong><em>Needs review</em></div>
        </div>
        <p>Fields normalize with confidence-aware extraction.</p>
      </article>
      <span class="deus-transformation-arrow" aria-hidden="true">→</span>
      <article class="deus-transformation-step" role="listitem">
        <div class="deus-transformation-step-head"><span>03</span><small>STRUCTURED RECORD</small></div>
        <div class="deus-record-sheet">
          <div class="deus-record-banner"><span>FHIR R4</span><strong>Clinical record</strong></div>
          <div class="deus-record-grid"><span>Patient</span><strong>Rajesh Sharma</strong><span>Encounter</span><strong>Diabetes follow-up</strong><span>Source</span><strong>Verified fields · 12</strong></div>
        </div>
        <p>Evidence becomes a reviewable clinical story.</p>
      </article>
      <span class="deus-transformation-arrow" aria-hidden="true">→</span>
      <article class="deus-transformation-step" role="listitem">
        <div class="deus-transformation-step-head"><span>04</span><small>CLINICIAN SIGN-OFF</small></div>
        <div class="deus-signoff-sheet">
          <span class="deus-signoff-check" aria-hidden="true">✓</span>
          <strong>Verified clinical record</strong>
          <small>Ready for EHR entry</small>
          <span class="deus-signoff-meta">Human-in-the-loop · Audit trail created</span>
        </div>
        <p>The clinician reviews, edits, and approves.</p>
